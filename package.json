{
  "name": "openrouter-clone",
  "private": true,
  "workspaces": [
    "aspire-apphost"
  ],
  "type": "module",
  "scripts": {
    "aspire": "mise exec -- aspire run",
    "aspire:restore": "mise exec -- aspire restore",
    "aspire:check": "mise exec -- aspire restore && mise exec -- tsc --noEmit -p aspire-apphost/tsconfig.apphost.json",
    "dev": "mise exec -- node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "mise exec -- node --env-file-if-exists=.env dist/index.js",
    "otel:up": "docker compose up -d aspire-dashboard",
    "otel:logs": "docker compose logs aspire-dashboard",
    "otel:down": "docker compose down",
    "lint": "mise exec -- oxlint --deny-warnings",
    "lint:fix": "mise exec -- oxlint --deny-warnings --fix",
    "fmt": "mise exec -- oxfmt",
    "fmt:check": "mise exec -- oxfmt --check",
    "check": "mise exec -- tsc --noEmit",
    "build": "mise exec -- tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@hono/node-server": "2.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "hono": "4.13.7",
    "openai": "7.10.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "@types/node": "24",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tsx": "4.23.13"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "bun@1.4.2"
}
